# Cloudflare Pages security & caching headers
# Applies these HTTP response headers to the deployed site.

/*
  # Stop the site being framed/click-jacked by other sites
  X-Frame-Options: SAMEORIGIN
  # Stop browsers guessing/altering file types
  X-Content-Type-Options: nosniff
  # Limit how much referrer info is shared with other sites
  Referrer-Policy: strict-origin-when-cross-origin
  # Disable powerful browser features the site doesn't use
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Force HTTPS for 2 years (HSTS)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Content Security Policy — only allow the sources this site actually needs
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com; frame-src https://www.google.com https://maps.google.com; form-action 'self'
  # Isolate the browsing context
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

# Long-lived caching for fingerprinted/static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/forms/*
  Cache-Control: public, max-age=86400

